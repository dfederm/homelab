# Template for a backup target. Copy this to <config_dir>/backup/<name>.env and edit,
# then add "<name>" to BACKUP_INSTANCES in the machine env file. No repo change needed.

# Source directory to back up, relative to BACKUP_DATA_ROOT (mounted read-only).
BACKUP_SOURCE_DIR=Alice
# rclone destination ("remote:path"). The remote must exist in the shared rclone config
# (${DOCKER_APPDATA_ROOT}/backup/rclone).
#
# IMPORTANT: the sync MIRRORS this exact path and PRUNES anything under it that isn't in the
# source, so each target's dest must be DISJOINT from every other target's dest. Two targets
# may share one remote only if they point at non-overlapping paths under it — e.g. a shared
# folder backed up into a person's drive must use a separate top-level path, not a subpath of
# that person's own backup:
#   personal:  BACKUP_DEST=onedrivealice:/nas-backup
#   shared:    BACKUP_DEST=onedrivealice:/nas-backup-shared/family   # NOT onedrivealice:/nas-backup/...
# This is enforced at deploy: services/backup/pre-up.sh aborts run-service if two targets' dests
# overlap on the same remote.
BACKUP_DEST=onedrivealice:/nas-backup
# Optional cron schedule for the recurring backup (default "0 3 * * *"). Stagger the minute
# across targets so they don't all run at once and contend on the shared rclone config —
# especially targets that share a remote (they write the same OAuth token back). e.g.:
#BACKUP_CRON=15 3 * * *

# Optional. Where the sync moves files it is about to overwrite or delete, instead of
# destroying them (rclone --backup-dir). Without this, a mirroring sync faithfully
# propagates a local corruption, a ransomware run, or an accidental deletion over the last
# good copy — the backup is destroyed by the very event it exists for. The move happens
# server-side, so it costs no extra upload.
# This keeps the most recent superseded copy of each file, not a full version history (the
# archive is a path too, so tomorrow's replacement overwrites today's archived copy).
# Must be on the SAME remote as BACKUP_DEST and DISJOINT from every target's destination
# (pre-up.sh enforces both).
#BACKUP_ARCHIVE_DEST=onedrivealice:/nas-backup-archive

# Optional. Space-separated rclone filter patterns to skip, for a source that mixes
# irreplaceable content with large regenerable content. Immich is the motivating case:
# thumbs/ and encoded-video/ are rebuilt from the originals after a restore.
#BACKUP_EXCLUDE=thumbs/** encoded-video/**

# Optional. Set to true for a target whose source holds secrets (the homelab config dir,
# staged database dumps). The sync then refuses to run unless BACKUP_DEST resolves to an
# rclone crypt remote, so those can never be uploaded in the clear by a config slip.
# NOTE: with a crypt remote the password IS the backup — store it somewhere that survives
# losing the lab (a password manager), not only in rclone.conf.
#BACKUP_REQUIRE_ENCRYPTION=true

# Optional. URL pinged after each SUCCESSFUL sync, for a dead-man's-switch monitor: it alerts
# when the ping doesn't arrive in time, which catches the failure a container-logs-only design
# cannot see — a backup that silently stopped running.
# Use a monitor that does NOT run on this lab. One hosted on the machine it watches goes quiet
# for the same reasons the backup did, and so reports nothing.
#BACKUP_HEARTBEAT_URL=https://<external-monitor>/ping/<token>

# Optional. Override the machine-wide BACKUP_DATA_ROOT for this target only, to back up
# something outside the user-share root (staged service state, an Immich library). The
# per-target env file is layered last, so this value wins.
#BACKUP_DATA_ROOT=/mnt/homelab

# Optional. Allow syncing an empty source directory. Off by default because an empty
# source usually means the bind mount resolved to the wrong path, and syncing it would
# delete the whole destination.
#BACKUP_ALLOW_EMPTY_SOURCE=true
