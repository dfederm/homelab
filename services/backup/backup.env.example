# Copy to <config_dir>/backup/<name>.env; add <name> to BACKUP_INSTANCES.

# Existing absolute Docker-host path; pre-up rejects missing/relative sources.
BACKUP_SOURCE_PATH=
# Existing rclone remote:path. Sync PRUNES this destination; targets on the
# same remote must use disjoint paths (never one inside another). pre-up
# rejects overlapping destinations before deployment.
BACKUP_DEST=onedrivealice:/nas-backup
# Optional cron (default "0 3 * * *"); stagger targets sharing rclone.conf
# to avoid concurrent OAuth-token rewrites.
#BACKUP_CRON=15 3 * * *
