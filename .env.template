####################
# Common
####################
# Put shared values in common.env; machine-specific values override them.
# Required IANA timezone; setup.sh reconciles it on every managed Linux machine.
TZ=

# Comma-separated list of services to deploy on this machine (order matters)
HOMELAB_SERVICES=

# Space-separated list of setup modules to run on this machine
# Modules are listed in README.md and scripts/setup/modules/.
HOMELAB_SETUP_MODULES=

# Seconds to retry apt lock contention (default 120); other failures are not retried.
APT_LOCK_TIMEOUT=

####################
# Users & Groups (machines needing user/group alignment)
####################

# Space-separated prefixes for role groups
# Each prefix requires: _GID
# Group name is derived by lowercasing the prefix.
# e.g. HOMELAB_GROUPS="ADULTS KIDS" with ADULTS_GID=1100
HOMELAB_GROUPS=

# Space-separated prefixes for user definitions
# Each prefix requires: _UID, _GROUPS (comma-separated group names)
# Optional: _SERVICE=1 for an infrastructure-only account (no personal or family share).
# Username is derived by lowercasing the prefix.
# A primary group with matching name and GID is created automatically.
# e.g. HOMELAB_USERS="ALICE BOB" with ALICE_UID=1001, ALICE_GROUPS="adults,family"
HOMELAB_USERS=

####################
# SSH
####################

# Optional: explicit path to authorized_keys file.
# Defaults to <config_dir>/authorized_keys (next to machine .env files).
SSH_AUTHORIZED_KEYS_FILE=

####################
# Network
####################
NETWORK_ROUTER_IP=
NETWORK_PREFIX=24

# Required by configure-network; omit that module to stay on DHCP.
# Gateway and prefix come from NETWORK_ROUTER_IP and NETWORK_PREFIX.
STATIC_IP=

# Optional: DNS servers for the static config (comma- or space-separated).
# Defaults to NETWORK_ROUTER_IP.
STATIC_DNS=

# DNS for LXC containers. Use the router, not AdGuard, so LXCs have DNS
# even when AdGuard is down or not yet deployed.
DNS_IP=

# Full subnet in CIDR notation (used by macvlan for AdGuard Home)
NETWORK_SUBNET=

####################
# ZFS / Storage
####################
ZFS_POOL=

# Storage health on the Proxmox host: empty schedule disables that feature.

# ZFS scrub: first Sunday of the month at 03:00 (systemd OnCalendar).
ZFS_SCRUB_SCHEDULE="Sun *-*-01..07 03:00:00"

# Daily pool health check.
ZFS_HEALTH_CHECK_SCHEDULE="*-*-* 08:00:00"

# smartd -s schedule (smartd.conf(5)): daily short and monthly long test.
# Empty disables tests, not drive monitoring.
SMART_SELFTEST_SCHEDULE="(S/../.././02|L/../15/./03)"

# Host pct fstrim returns freed LXC rootfs blocks to the LVM thin pool.
# Empty removes the timer; VMs reclaim separately via discard=on.
LXC_FSTRIM_SCHEDULE=weekly

# Docker host: prune images unused by any container; empty removes the timer.
# Schedule before LXC_FSTRIM_SCHEDULE so the host trim returns freed blocks.
DOCKER_IMAGE_PRUNE_SCHEDULE="Sun *-*-* 04:00:00"

####################
# Hardware monitoring
####################

# Space-separated hwmon kernel modules the configure-sensors module loads on boot,
# on top of installing lm-sensors. Use `sensors-detect` to identify board
# hwmon modules; empty installs lm-sensors only.
SENSORS_KERNEL_MODULES=

####################
# Kernel command line
####################

# Space-separated key or key=value parameters (e.g. "iommu=pt").
# configure-kernel-cmdline detects the active bootloader, rejects duplicate
# keys, and reports pending reboot; empty leaves the command line unchanged.
KERNEL_CMDLINE_PARAMS=

####################
# NVIDIA GPUs
####################

# Exact apt driver version shared by host and GPU LXC (e.g. "610.43.02-1").
# Pin a version available for both Debian releases: mismatched kernel/userspace
# drivers fail. Empty uses each machine's repo version, unsafe for a GPU LXC.
NVIDIA_DRIVER_VERSION=

# Per-GPU power cap in watts, re-applied on every boot and whenever the driver
# version changes. Empty leaves the cards at their stock limit.
# Measure GPU and drive temperatures under load before choosing a cap; see
# scripts/setup/modules/configure-nvidia-driver.md for safe tuning and rollback.
NVIDIA_POWER_LIMIT_WATTS=

####################
# Proxmox Host
####################
PROXMOX_IP=
PROXMOX_WEB_PORT=

# Space-separated env var prefixes for LXC definitions
# e.g. "DOCKER_LXC NAS_LXC"
# Each prefix requires: _VMID, _HOSTNAME, _IP, _MEMORY_MIB, _CORES,
#   _ROOTFS_GIB, _NESTING, _MP0 (and optionally _MP1, _MP2, ...)
# Optional: _GPU, _NVIDIA_GPU, _USB_DEVICES
HOMELAB_LXCS="DOCKER_LXC NAS_LXC"

# Space-separated env var prefixes for VM definitions
# e.g. "HAOS_VM"
# Each prefix requires: _VMID, _HOSTNAME, _MEMORY_MIB, _CORES
# Optional: _BIOS (seabios), _MACHINE (i440fx), _OSTYPE (l26), _AGENT (0)
# Optional: _IMAGE (path to disk image file, imported on first create only)
# Optional: _IP (informational only, not passed to qm)
HOMELAB_VMS="HAOS_VM"

# Space-separated prefixes for host LVM-thin volumes (provision-host-volumes).
# Each prefix requires: _LV_NAME, _SIZE_GIB, _MOUNTPOINT
# Optional: _THINPOOL (default pve/data), _FS (default ext4)
HOMELAB_HOST_VOLUMES="AI_MODELS_SSD"

# AI model store; thin virtual size only backs written data.
AI_MODELS_SSD_LV_NAME=ai-models-ssd
AI_MODELS_SSD_SIZE_GIB=150
AI_MODELS_SSD_MOUNTPOINT=/mnt/ai-models-ssd

# Docker LXC
