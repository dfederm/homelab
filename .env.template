####################
# Webhook
####################

WEBHOOK_HTTP_PORT=

WEBHOOK_FQDN=

# HMAC-SHA256 shared secret (must match GitHub webhook configuration)
WEBHOOK_SECRET=

# Cloneable without interaction by every top-level worker; set in common.env.
DEPLOY_REPOSITORY_URL=

# Persistent-but-disposable local checkout used by automated deployments and,
# on Proxmox, synchronized into each LXC before its setup runs.
HOMELAB_REPO_DIR=/opt/homelab/repo

# Target-local coordinator state and preserved per-run logs. The log directory
# contains a latest.log symlink to the active or most recent run.
DEPLOY_STATE_DIR=/var/lib/homelab-deploy
DEPLOY_LOG_DIR=/var/log/homelab-deploy

# Remove per-run deployment logs older than this many days. The log referenced
# by latest.log is retained until a newer run replaces it.
DEPLOY_RETENTION_DAYS=30

# Rotate the target-local event log after this many bytes, retaining one
# previous segment as events.log.1.
DEPLOY_EVENT_LOG_MAX_BYTES=1048576

# Reconciliation starts after this boot delay and repeats at this interval.
# It fetches origin/main and runs setup only when it differs from the last
# successful commit. Pending webhook signals are handled immediately.
DEPLOY_BOOT_DELAY_SEC=60
DEPLOY_RECONCILE_INTERVAL_SEC=900

# Docker LXC key for signaling workers; failed signals recover on reconciliation.
DEPLOY_KEY_PATH=

# Space-separated prefixes for remote machines that receive deployments.
# Each prefix requires: _DEPLOY_HOST
# e.g. HOMELAB_DEPLOY_TARGETS="PROXMOX_HOST PI"
# Each listed machine must enable configure-deploy-worker. Do not list or enable
# the worker on LXCs already reached through a Proxmox create-lxcs cascade.
HOMELAB_DEPLOY_TARGETS=

