DOCKER_LXC_HOSTNAME=
DOCKER_LXC_IP=
DOCKER_LXC_MEMORY_MIB=
DOCKER_LXC_CORES=
DOCKER_LXC_ROOTFS_GIB=
DOCKER_LXC_NESTING=
# Bind mounts: <zfs_dataset>,mp=<container_path>
DOCKER_LXC_MP0=
DOCKER_LXC_MP1=
DOCKER_LXC_MP2=
# Set to 1 to pass through /dev/dri for hardware transcoding (VAAPI)
DOCKER_LXC_GPU=
# Set to 1 for /dev/nvidia* passthrough (independent of _GPU). The host
