####################
# UPS monitoring (configure-ups-monitoring module, Proxmox host)
####################
# NUT name exposed to monitoring clients such as Home Assistant.
NUT_UPS_NAME=
# Optional human-readable description reported by NUT.
NUT_UPS_DESCRIPTION=
# Proxmox host LAN address on which NUT accepts read-only monitoring clients.
# Usually the same value as PROXMOX_IP.
NUT_LISTEN_ADDRESS=
# Warn before the UPS reaches its hard overload state.
UPS_LOAD_WARNING_PERCENT=80
# Ignore brief Powerwall transfer events; alert only if on-battery persists.
UPS_ON_BATTERY_ALERT_DELAY_SECONDS=30
# Ignore short NUT restarts; alert if telemetry remains unavailable.
UPS_COMM_FAILURE_ALERT_DELAY_SECONDS=120
# Repeat a still-active UPS alert after this many hours. Set 0 to alert every check.
UPS_ALERT_REPEAT_HOURS=12

