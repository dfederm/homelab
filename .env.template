####################
# Docker Host
####################

DOCKER_APPDATA_ROOT=

REPO_DIR=

CONFIG_DIR=

DOCKER_HOST_IP=

NETWORK_INTERFACE=

####################
# NAS (Samba)
####################

SHARE_ROOT=

# Optional: name for a root-level SMB share exposing SHARE_ROOT (adults only)
SMB_ROOT_SHARE=

# Optional: path to media library (creates admin-only SMB share)
SMB_MEDIA_PATH=

# Optional: path to homelab data (creates admin-only SMB share)
SMB_HOMELAB_PATH=

# Space-separated absolute config dirs written by services and edited via SMB.
# install-samba grants root and the admin group write access without exposing
