# NAS LXC
NAS_LXC_VMID=
NAS_LXC_HOSTNAME=
NAS_LXC_IP=
NAS_LXC_MEMORY_MIB=
NAS_LXC_CORES=
NAS_LXC_ROOTFS_GIB=
NAS_LXC_NESTING=
NAS_LXC_MP0=
NAS_LXC_MP1=
NAS_LXC_MP2=

# Home Assistant VM
HAOS_VM_VMID=
HAOS_VM_HOSTNAME=
HAOS_VM_IP=
HAOS_VM_MEMORY_MIB=
HAOS_VM_CORES=
HAOS_VM_BIOS=ovmf
HAOS_VM_MACHINE=q35
HAOS_VM_OSTYPE=l26
HAOS_VM_AGENT=1
