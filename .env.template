####################
# Koffan (shared shopping list)
####################
KOFFAN_FQDN=
KOFFAN_HTTP_PORT=
# true = disable Koffan's built-in login and defer auth to the reverse proxy (Authelia). Keep
# false until Authelia is in place; see the Koffan section in the top-level README.md.
KOFFAN_DISABLE_AUTH=false
# Login password, used when KOFFAN_DISABLE_AUTH=false. A SECRET — set a strong value (the app is
# publicly exposed); a blank value falls back to Koffan's public default password.
KOFFAN_APP_PASSWORD=
