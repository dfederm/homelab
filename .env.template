SMB_ADMIN_CONFIG_DIRS=

####################
# Adguard Home
####################
ADGUARDHOME_IP=
ADGUARDHOME_WEB_PORT=

####################
# AI (llama-swap + llama-server + LiteLLM + Open WebUI + SearXNG)
####################
# Host path for GGUF files; ai pre-up verifies the model manifest and SHA-256.
LLAMA_MODELS_ROOT=

# Per-model GPU placement belongs in external llama-swap config, not here.
LLAMA_SWAP_NVIDIA_VISIBLE_DEVICES=all

# Authenticated LAN-only gateway; aliases live in ${CONFIG_DIR}/litellm/config.yaml.
LITELLM_HTTP_PORT=

# Password is interpolated into DATABASE_URL; use a URL-safe value.
LITELLM_DB_NAME=litellm
LITELLM_DB_USERNAME=litellm
LITELLM_DB_PASSWORD=

# Independently generated sk- secrets. Never give clients the master key or
# rotate the salt: credentials encrypted with the old salt become unreadable.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Space-separated client prefixes, each with LITELLM_<PREFIX>_KEY_ALIAS,
# _API_KEY and _MODELS. OPEN_WEBUI is required; allowlists must match external config.
LITELLM_CLIENTS=OPEN_WEBUI

# The API key is a secret and must start with sk-.
LITELLM_OPEN_WEBUI_KEY_ALIAS=
LITELLM_OPEN_WEBUI_API_KEY=
LITELLM_OPEN_WEBUI_MODELS=

# Client keys must all differ from each other, the master, and the salt.
# Changing one revokes the old key during the next ai deploy before creating
# its replacement; rotate during a low-use window.

OPEN_WEBUI_FQDN=
OPEN_WEBUI_HTTP_PORT=
# LiteLLM aliases used for Open WebUI background tasks and RAG embeddings.
# Both must be present in LITELLM_OPEN_WEBUI_MODELS and readable by non-admin
# users under Admin Settings -> Models.
OPEN_WEBUI_TASK_MODEL_EXTERNAL=family-utility
OPEN_WEBUI_RAG_EMBEDDING_MODEL=family-embedding
# Open WebUI's OpenAI-compatible connection is pinned to internal LiteLLM in Compose.
# OIDC client secret: plaintext here, paired digest in the external Authelia
# config; see services/authelia/README.md. Never commit real secrets.
OPEN_WEBUI_OIDC_CLIENT_SECRET=
# Shared with Athena MCP to verify forwarded user identity. HS256 requires
# at least 32 characters (`openssl rand -hex 32`); keep the value secret.
OPEN_WEBUI_FORWARD_USER_JWT_SECRET=

# Internal-only SearXNG secret; generate with `openssl rand -hex 32`.
SEARXNG_SECRET=

# Beszel hub credentials — a dedicated read-only Beszel user (create it in the Beszel UI). Each host
# must be SHARED with this user in Beszel or it is missing from list_systems (see README).
ATHENA_MCP_BESZEL_IDENTITY=
ATHENA_MCP_BESZEL_PASSWORD=
# PocketBase auth collection to authenticate against. Optional — defaults to `users` (a normal
# Beszel user). Set to `_superusers` only if a superuser token is required to read every host's
# records.
ATHENA_MCP_BESZEL_AUTH_COLLECTION=
ATHENA_MCP_PROXMOX_NODE=
# Proxmox API token for a read-only PVEAuditor user, in `user@realm!tokenid` form. Both the user AND
# the token need the PVEAuditor role at `/` (privilege separation — see README).
ATHENA_MCP_PROXMOX_TOKEN_ID=
ATHENA_MCP_PROXMOX_TOKEN_SECRET=
# The canonical user roster and per-user Vikunja, Radicale, Jellyfin, Immich, and Home Assistant
# credentials live in ${CONFIG_DIR}/athena/users.json instead of environment variables. The file is
# mounted read-only at /run/secrets/athena-users.json. It contains PII and secrets: never commit it,
# print it, or include it in validation output. See README.md for the schema, creation, cutover, and
# rollback procedure.
#
# Shared curated knowledge lives in ${CONFIG_DIR}/athena/knowledge and is mounted read-only at
# /knowledge. Athena expects registry/household.yaml and top-level curated/shared/*.md files there.
# The corpus is private family data: keep it on the NAS and never commit or print it. The host path
# is derived from CONFIG_DIR, so there is no separate environment variable for it.
#
# Radicale shared collection paths remain ordinary non-credential configuration. Radicale's
# BaseUrl reuses DOCKER_HOST_IP + RADICALE_HTTP_PORT.
# Path suffix (no leading slash) of the shared family calendar collection under the DAV root, joined
# onto the host:port origin to form Apps__Radicale__FamilyCalendarUrl (e.g. family/calendar/).
ATHENA_MCP_RADICALE_FAMILY_CALENDAR_URL=
# Path suffix (no leading slash) of the shared family contacts (addressbook) collection under the DAV
# root, joined onto the host:port origin to form Apps__Radicale__FamilyContactsUrl (e.g. family/contacts/).
ATHENA_MCP_RADICALE_FAMILY_CONTACTS_URL=
#
# Optional SearXNG domain filter list. JSON array string; leave blank for no filtering.
ATHENA_MCP_SEARXNG_DOMAIN_FILTER_LIST=

# Per-user Home Assistant state and curated exact-target actions. Athena MCP reads only entities
# exposed to HA's conversation assistant, then permits at most one proof-bound action per Open WebUI
# message for an exact non-group light, switch, fan, or climate entity. Broad targets, groups,
# arbitrary services, toggles, batches, locks, covers, alarms, scenes, scripts, automations,
# broadcasts, timers, media players, and other unlisted controls are unavailable.
#
# Signed exact-target proof lifetime in seconds (30-300). Defaults to 90.
ATHENA_MCP_HOMEASSISTANT_TARGET_PROOF_LIFETIME_SECONDS=90
#
# Exact HA entity ids that may be read but must never receive an action proof. Populate only from a
# fresh Assist-exposed hazard inventory; keep the list small and hazard-focused. JSON array of
# non-blank strings; use [] for no denied entities.
ATHENA_MCP_HOMEASSISTANT_DENIED_ENTITY_IDS=[]

####################
# Authelia (single sign-on / OIDC identity provider)
####################
# Public hostname of the Authelia login portal, routed through Caddy (e.g. auth.example.com).
# OIDC apps redirect here to sign in. Wildcard DNS already resolves it, so only the Caddy site
# block is needed.
AUTHELIA_FQDN=
# The parent domain the session cookie is scoped to (e.g. example.com) — must be the domain that
# every SSO-participating service shares, so one session spans *.<domain>.
AUTHELIA_ROOT_DOMAIN=
# Host port mapped to Authelia (container port 9091). Caddy (network_mode: host) proxies
# AUTHELIA_FQDN to localhost:<this>. Authelia serves plain HTTP here; Caddy terminates TLS.
AUTHELIA_HTTP_PORT=
# Scalar secrets. Generate independently; see services/authelia/README.md.
# Signs session cookies.
AUTHELIA_SESSION_SECRET=
# Encrypts sensitive columns in Authelia's SQLite storage.
AUTHELIA_STORAGE_ENCRYPTION_KEY=
# Signs identity-verification (e.g. password-reset) JWTs.
AUTHELIA_JWT_SECRET=
# Signs the HMAC of issued OIDC tokens.
AUTHELIA_OIDC_HMAC_SECRET=
#
# Before deploying, create users.yml, oidc.private.pem, and
# open-webui-client.digest under <config_dir>/authelia/; a missing bind source
# becomes a directory. The digest must be a file: Compose mangles its '$' characters.

